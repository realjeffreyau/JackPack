{
  "name": "jackpack",
  "version": "1.0.0",
  "description": "A playful collection of local and online party games built with Expo and React Native.",
  "author": "Jeffrey Au",
  "keywords": [
    "expo",
    "react-native",
    "typescript",
    "party-games",
    "multiplayer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/realjeffreyau/JackPack.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate": "tsc --noEmit && expo export --platform ios --output-dir .validate-out && rm -rf .validate-out"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.2.3",
    "@expo-google-fonts/nunito": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/material-top-tabs": "^7.6.7",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.35",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-font": "~14.0.12",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-pager-view": "6.9.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tab-view": "^4.3.1",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "^5.9.2"
  },
  "private": true
}
